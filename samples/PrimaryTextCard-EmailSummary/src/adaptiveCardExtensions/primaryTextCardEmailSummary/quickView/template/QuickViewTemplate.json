{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "text": "${title}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${subTitle}",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true
    },
    {
      "type": "Container",
      "$when": "${showLoading}",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "\u29D7",
                  "size": "ExtraLarge",
                  "weight": "Bolder",
                  "color": "Accent"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${loadingTitle}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${loadingHelper}",
                  "isSubtle": true,
                  "wrap": true,
                  "spacing": "Small"
                },
                {
                  "type": "TextBlock",
                  "text": "${loadingText}",
                  "isSubtle": true,
                  "wrap": true,
                  "spacing": "Small",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${showError}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${errorText}",
          "wrap": true,
          "color": "Attention"
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${showReady}",
      "items": [
        {
          "type": "TextBlock",
          "weight": "Bolder",
          "size": "Medium",
          "text": "${emailSubject}",
          "wrap": true
        },
        {
          "type": "FactSet",
          "spacing": "Small",
          "facts": [
            {
              "title": "${fromLabel}",
              "value": "${fromValue}"
            },
            {
              "title": "${receivedLabel}",
              "value": "${receivedValue}"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${showReady}",
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "weight": "Bolder",
          "text": "${summaryTitle}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "$when": "${showSummaryLoading}",
          "text": "${summaryLoadingText}",
          "isSubtle": true,
          "wrap": true
        },
        {
          "type": "TextBlock",
          "$when": "${showSummaryError}",
          "text": "${summaryErrorText}",
          "color": "Attention",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "$when": "${showSummaryText}",
          "text": "${summaryText}",
          "wrap": true
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "id": "openInOutlook",
      "$when": "${showOpenInOutlookAction}",
      "title": "${openInOutlookLabel}",
      "url": "${openInOutlookUrl}"
    }
  ]
}
