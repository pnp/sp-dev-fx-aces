{
  "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "size": "Medium",
      "text": "${heading}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "$when": "${!hasSkills}",
      "text": "${emptyMessage}",
      "wrap": true
    },
    {
      "type": "Container",
      "$data": "${skills}",
      "separator": true,
      "spacing": "Medium",
      "selectAction": {
        "type": "Action.Submit",
        "data": {
          "id": "openSkill",
          "index": "${index}"
        }
      },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "weight": "Bolder",
                  "size": "Default",
                  "text": "${title}",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${description}",
                  "wrap": true,
                  "spacing": "Small",
                  "isSubtle": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${chevron}",
                  "size": "Large",
                  "color": "Accent",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
