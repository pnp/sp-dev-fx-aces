{
  "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "size": "Medium",
      "text": "${heading}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "$when": "${!hasSkills}",
      "text": "${emptyMessage}",
      "wrap": true
    },
    {
      "type": "Container",
      "$data": "${skills}",
      "separator": true,
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "weight": "Bolder",
          "size": "Default",
          "text": "${title}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${description}",
          "wrap": true,
          "spacing": "Small",
          "isSubtle": true
        }
      ]
    }
  ]
}
