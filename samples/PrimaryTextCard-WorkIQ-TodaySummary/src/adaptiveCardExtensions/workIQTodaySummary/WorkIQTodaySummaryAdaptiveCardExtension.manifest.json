    "title": { "default": "Today with Work IQ" },
    "description": { "default": "A Work IQ-generated summary of what's relevant to you today, on your Viva Connections dashboard." },
    "officeFabricIconFontName": "lightbulb",
    "properties": {
      "cardTitle": "Today with Work IQ",
      "proxyFunctionUrl": "",
      "proxyResourceId": "",
      "refreshIntervalMinutes": "60",
      "includeTeamsMessages": false
    }
  }]
